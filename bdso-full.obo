[Term]
id: PCL:0019001
name: Inh SST NPY primary motor cortex GABAergic interneuron (Cjac)
def: "A GABAergic interneuron of the Callithrix jacchus primary motor cortex. These cells can be distinguished from other cells in the primary motor cortex by their selective expression of NPY (Cjac). These cells also express SST (Cjac), NPY (Cjac). The reference data for this cell type is CS201912132_1." [PMID:34616062]
synonym: "Inh SST NPY" EXACT []
synonym: "NPY (Cjac) expressing GABAergic interneuron of primary motor cortex (Callithrix jacchus)" EXACT []
synonym: "Sst Chodl" EXACT []
is_a: PCL:0019119 ! Sst Chodl(i) primary motor cortex GABAergic interneuron (Cjac)
relationship: RO:0002292 http://identifiers.org/ncbigene/100385471 {xref="PMID:34616066"} ! expresses NPY (Cjac)
relationship: RO:0002292 http://identifiers.org/ncbigene/100412902 {xref="PMID:34616066"} ! expresses SST (Cjac)
relationship: RO:0015004 PCL:0020501 ! has characterizing marker set NS forest marker set of Inh SST NPY M1 (Marmoset).
property_value: IAO:0000028 "Inh SST NPY M1 (Marmoset)" xsd:string
property_value: PCL:0010058 "NPY (Cjac)" xsd:string
property_value: skos:prefLabel "Inh SST NPY" xsd:string

[Term]
id: PCL:0019002
name: Inh LAMP5 COL5A2 primary motor cortex GABAergic interneuron (Cjac)
def: "A GABAergic interneuron of the Callithrix jacchus primary motor cortex. These cells can be distinguished from other cells in the primary motor cortex by their selective expression of TOX3 (Cjac), GLIS3 (Cjac). These cells also express LAMP5 (Cjac), COL5A2 (Cjac). The reference data for this cell type is CS201912132_2." [PMID:34616062]
synonym: "Inh LAMP5 COL5A2" EXACT []
synonym: "Lamp5_5" EXACT []
synonym: "TOX3 (Cjac), GLIS3 (Cjac) expressing GABAergic interneuron of primary motor cortex (Callithrix jacchus)" EXACT []

[Term]
id: CL:0000300
name: gamete
def: "A mature sexual reproductive cell having a single set of unpaired chromosomes." [GOC:tfm, ISBN:0721662544]
synonym: "haploid germ cell" RELATED []
synonym: "haploid nucleated cell" EXACT []
xref: CALOHA:TS-0395
xref: FBbt:00005412 {sssom:mapping_justification="vocab:ManualMappingCuration"}
xref: FMA:18649
xref: ZFA:0009156 {sssom:mapping_justification="vocab:UnspecifiedMatching"}
